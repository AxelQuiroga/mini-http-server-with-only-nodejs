# Configuración PostgreSQL local (desarrollo) — template.
# Copiá este archivo a .env y ajustá los valores.
# Alternativa automática: `bash scripts/setup-postgres.sh` genera .env con una
# password aleatoria (permisos 600) y crea rol + base de datos idempotentemente.
PGHOST=localhost
PGPORT=5432
PGUSER=videouser
PGPASSWORD=change-me
PGDATABASE=videocatalog